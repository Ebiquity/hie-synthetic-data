mf:FrailtyEncounter a mf:ValueSet ;
    rdfs:label "Frailty Encounter" ;
    dcterms:identifier "Value Set Name" ;
    mf:hasCodeSystem "HCPCS" ;
    dcterms:type "Extensional" ;
    dcterms:hasVersion "20260107" ;
    dcterms:publisher "National Committee for Quality Assurance" ;
    rdfs:seeAlso <http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.464.1003.101.11.1279> ;
    rdfs:comment "Clinical Focus: The purpose of this value set is to represent concepts for encounters for nursing care services provided to frail patients." ;
    rdfs:comment "Data Element Scope: This value set may use a model element related to Encounter." ;
    rdfs:comment "Inclusion Criteria: Includes concepts that represent an encounter for nursing care and home care services provided to frail patients." ;
    rdfs:comment "Exclusion Criteria: No exclusions." ;
    mf:INCLUDES mf:G0162
        , mf:G0299
        , mf:G0300
        , mf:G0493
