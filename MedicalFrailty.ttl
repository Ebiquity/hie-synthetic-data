@prefix mf: <https://medicaidpolygraph.com/medical_frailty#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# --- Properties ---

mf:INCLUDES a rdf:Property ;
    rdfs:comment "Relates a value set to its member codes" .

mf:belongsToValueSet a rdf:Property ;
    rdfs:comment "Relates a code to the value set it belongs to" .

mf:hasCodeSystem a rdf:Property ;
    rdfs:comment "The code system a code belongs to" .

mf:hasCodeSystemVersion a rdf:Property ;
    rdfs:comment "The version of the code system" .

mf:hasCodeSystemOID a rdf:Property ;
    rdfs:comment "The OID of the code system" .

mf:hasTTY a rdf:Property ;
    rdfs:comment "The term type (TTY) of the code" .

mf:isMemberOf a rdf:Property ;
    rdfs:comment "Relates a grouping value set to its member value sets" .

# --- Classes ---

mf:ValueSet a rdfs:Class ;
    rdfs:comment "A set of medical codes used to identify medical frailty" .

mf:Code a rdfs:Class ;
    rdfs:comment "A medical code (CPT, HCPCS, ICD-10-CM) indicating frailty" .

